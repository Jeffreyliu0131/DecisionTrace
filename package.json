{
  "name": "decisiontrace",
  "version": "0.5.0",
  "private": true,
  "description": "Local-first product contract traceability and deterministic drift detection.",
  "type": "module",
  "bin": {
    "decisiontrace": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "schemas",
    "action.yml"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.build.json && node scripts/export-schemas.mjs",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture:eval": "node dist/cli/main.js eval --dataset fixtures/eval-cases.yml --output .decisiontrace/eval",
    "demo": "npm run build && node scripts/demo.mjs",
    "demo:check": "node scripts/demo.mjs --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run fixture:eval && npm run demo:check",
    "dev": "concurrently -k -n api,ui npm:dev:api npm:dev:ui",
    "dev:api": "tsx watch src/cli/main.ts ui --api-only --port 4173",
    "dev:ui": "vite",
    "ui": "node dist/cli/main.js ui"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "minimatch": "^10.2.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.8",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
