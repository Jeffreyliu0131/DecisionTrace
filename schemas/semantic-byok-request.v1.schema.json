{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": { "type": "string", "const": "decisiontrace.semantic.v1" },
    "model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "limits": {
      "type": "object",
      "properties": {
        "maxOutputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 32768
        }
      },
      "required": ["maxOutputTokens"],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "inputId": { "type": "string", "pattern": "^SIN-[a-f0-9]{12}$" },
        "scanId": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["local", "cloud"] },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^CTR-\\d{3}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 500 },
              "topic": { "type": "string", "minLength": 1, "maxLength": 200 },
              "rule": {
                "type": "object",
                "properties": {
                  "operator": {
                    "type": "string",
                    "enum": ["require", "forbid", "allow", "limit"]
                  },
                  "object": { "type": "string", "minLength": 1 },
                  "applies_to": {
                    "minItems": 1,
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                },
                "required": ["operator", "object", "applies_to"],
                "additionalProperties": false
              }
            },
            "required": ["id", "title", "topic", "rule"],
            "additionalProperties": false
          }
        },
        "sources": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^SRC-[a-f0-9]{12}$" },
              "artifactId": {
                "type": "string",
                "pattern": "^ART-[a-f0-9]{12}$"
              },
              "category": {
                "type": "string",
                "enum": [
                  "requirements",
                  "decisions",
                  "ai_policies",
                  "implementation",
                  "tests",
                  "evals",
                  "public_claims"
                ]
              },
              "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "startLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "pointer": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "truncated": { "type": "boolean" }
            },
            "required": [
              "id",
              "artifactId",
              "category",
              "contentHash",
              "text",
              "truncated"
            ],
            "additionalProperties": false
          }
        },
        "changedSourceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SRC-[a-f0-9]{12}$" }
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxSourceCharacters": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 4000
            },
            "maxTotalCharacters": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "required": ["maxSourceCharacters", "maxTotalCharacters"],
          "additionalProperties": false
        },
        "stats": {
          "type": "object",
          "properties": {
            "sourceCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "contractCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "characterCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "redactionCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "truncatedSourceCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "sourceCount",
            "contractCount",
            "characterCount",
            "redactionCount",
            "truncatedSourceCount"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "inputId",
        "scanId",
        "mode",
        "contracts",
        "sources",
        "changedSourceIds",
        "limits",
        "stats"
      ],
      "additionalProperties": false
    }
  },
  "required": ["protocol", "model", "limits", "input"],
  "additionalProperties": false,
  "title": "DecisionTraceSemanticByokRequestV1"
}
