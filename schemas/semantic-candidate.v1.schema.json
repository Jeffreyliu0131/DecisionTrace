        "reviewStatus": { "type": "string", "const": "candidate" },
        "status": { "type": "string", "const": "exploratory" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 256 },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceIds": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": { "type": "string", "pattern": "^SRC-[a-f0-9]{12}$" }
        },
        "sources": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "startLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "locator": { "type": "string", "minLength": 1 },
              "pointer": { "type": "string", "minLength": 1 },
              "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        },
        "suggestedReview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "driftType": { "type": "string", "enum": ["D1", "D2", "D3"] },
        "contractIds": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": { "type": "string", "pattern": "^CTR-\\d{3}$" }
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        }
      },
      "required": [
        "kind",
        "id",
        "basis",
        "reviewStatus",
        "status",
        "provider",
        "statement",
        "confidence",
        "sourceIds",
        "sources",
        "suggestedReview",
        "driftType",
        "contractIds",
        "severity"
      ],
      "additionalProperties": false
    }
  ],
  "title": "DecisionTraceSemanticCandidateV1"
}
